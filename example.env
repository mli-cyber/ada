# Ada (AI-Driven Assistant) configuration
# Copy this file to `.env` and adjust values as needed:
#   cp example.env .env
#
# Ada connects to AWS Bedrock the same way as the AISI IWB project: a boto3 Session
# built from your AWS profile + region. Reuse the same SSO/IAM profile you already use.

# --- AWS / Bedrock connection ---
AWS_PROFILE=<your-sso-or-iam-profile>
AWS_REGION=us-east-1

# Chat model (override as your account's Bedrock access allows).
ADA__BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-5

# Optional chat model switch list (comma-separated Bedrock model IDs).
ADA__BEDROCK_CHAT_MODELS=us.anthropic.claude-sonnet-5,us.anthropic.claude-opus-5,us.amazon.nova-pro-v1:0

# Capability-based model registry (first entry is primary; remaining entries are fallbacks).
ADA__MODEL_TIER=balanced
ADA__MODELS_HIGH=us.anthropic.claude-opus-5,us.anthropic.claude-sonnet-5
ADA__MODELS_BALANCED=us.anthropic.claude-sonnet-5,us.amazon.nova-pro-v1:0,openai.gpt-oss-120b-1:0
ADA__MODELS_ECONOMY=us.amazon.nova-pro-v1:0,openai.gpt-oss-120b-1:0,us.meta.llama3-1-70b-instruct-v1:0,mistral.mistral-large-3,google.gemma-3-27b-it
ADA__HIGH_MAX_TOKENS=16384
ADA__BALANCED_MAX_TOKENS=8192
ADA__ECONOMY_MAX_TOKENS=4096
ADA__HIGH_MAX_AGENT_LOOPS=12
ADA__BALANCED_MAX_AGENT_LOOPS=8
ADA__ECONOMY_MAX_AGENT_LOOPS=5

# Fixed embedding model (not user-switchable; changing it requires reset + re-ingest).
ADA__BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Application profile (see roadmap Section 4.3 / Phase 2) ---
# military (initial) or general.
ADA__PROFILE=military

# --- Generation controls ---
ADA__CHAT_TEMPERATURE=0.2
ADA__CHAT_MAX_TOKENS=8192

# --- Local storage paths (local-first defaults) ---
ADA__DATA_PATH=src/ada/tmp/data
ADA__DB_URL=sqlite:///src/ada/tmp/data/ada.db
ADA__CHROMA_PATH=src/ada/tmp/chroma
ADA__CHROMA_COLLECTION=ada-rag
ADA__OBJECT_STORE_PATH=src/ada/tmp/objects

# --- Phase 0 security and governance ---
ADA__SECRETS_BACKEND=env
ADA__DEV_USER=dev@ada.local
ADA__DEV_ROLE=admin
ADA__MAX_AGENT_LOOPS=8
ADA__REQUEST_TIMEOUT_SECONDS=30
